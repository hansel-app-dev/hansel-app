DATABASE_URL=postgresql://hansel:hansel@localhost:5433/hansel?schema=public
PORT=3000
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:5173
DISCOVERY_ENABLED=true
WELCOME_EMAIL_ENABLED=true
SITES_ENABLED=true
SITE_ACTIVITY_ENABLED=true
SITE_COVER_IMAGE_ENABLED=false
ORGANIZATION_TRAY_SETTINGS_ENABLED=true
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=replace-with-a-secret-from-aws-secrets-manager
RESEND_FROM_EMAIL=Hansel <onboarding@example.com>
PASSWORD_PEPPER=replace-with-a-secret-from-aws-secrets-manager
VERIFICATION_DIGEST_KEY=replace-with-an-independent-secret-from-aws-secrets-manager
APPLICATION_SESSION_DIGEST_KEY=replace-with-a-separate-session-secret-from-aws-secrets-manager
ALLOCATION_PLAN_SIGNS_ENABLED=false
SIGN_DOCUMENTS_ENABLED=false
SIGN_PHOTOS_ENABLED=false
SIGN_COMMENTS_ENABLED=false
