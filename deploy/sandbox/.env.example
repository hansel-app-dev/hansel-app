# Examples only. Install individual root-owned 0600 files under /etc/hansel-sandbox.
# postgres.env:
POSTGRES_USER=hansel
POSTGRES_DB=hansel
POSTGRES_PASSWORD=GENERATE_A_RANDOM_SANDBOX_PASSWORD
# api.env (same DB_PASSWORD as POSTGRES_PASSWORD):
DB_PASSWORD=GENERATE_A_RANDOM_SANDBOX_PASSWORD
ALLOWED_ORIGIN=https://AWS_ASSIGNED_STATIC_IPV4
PASSWORD_PEPPER=GENERATE_RANDOM_32_BYTE_SECRET
VERIFICATION_DIGEST_KEY=GENERATE_RANDOM_32_BYTE_SECRET
APPLICATION_SESSION_DIGEST_KEY=GENERATE_RANDOM_32_BYTE_SECRET
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=INSTALL_SECURELY
RESEND_FROM_EMAIL=INSTALL_VERIFIED_SENDER
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=SANDBOX_STORAGE_USER_ONLY
AWS_SECRET_ACCESS_KEY=SANDBOX_STORAGE_USER_ONLY
ALLOCATION_PLANS_BUCKET_NAME=SANDBOX_UPLOAD_BUCKET
LOGIN_ENABLED=true
PASSWORD_RECOVERY_ENABLED=true
WELCOME_EMAIL_ENABLED=true
PERSONAL_PROFILE_ENABLED=true
PLAN_SELECTION_ENABLED=true
ORGANIZATION_PROFILE_ENABLED=true
DISCOVERY_ENABLED=true
DASHBOARD_ENABLED=true
ORGANIZATION_TRAY_SETTINGS_ENABLED=true
SITES_ENABLED=true
SITE_ACTIVITY_ENABLED=true
SITE_COVER_IMAGE_ENABLED=true
ALLOCATION_PLANS_ENABLED=true
ALLOCATION_PLAN_DRAFTS_ENABLED=true
ALLOCATION_PLAN_SIGNS_ENABLED=true
SIGNAGE_SCHEDULE_ENABLED=true
SIGN_DOCUMENTS_ENABLED=true
SIGN_PHOTOS_ENABLED=true
SIGN_COMMENTS_ENABLED=true
PLAN_COMMENTS_ENABLED=true
EXTERNAL_AUTH_ENABLED=false
# address.env: SANDBOX_ADDRESS=AWS_ASSIGNED_STATIC_IPV4
# backup-target.env: BACKUPS_BUCKET=SANDBOX_BACKUP_BUCKET
# backup.env: AWS_REGION plus AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# for the separate hansel-sandbox-backups user, never the provisioning credentials.
