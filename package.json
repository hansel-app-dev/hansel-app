{
  "name": "hansel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @hansel/api --filter @hansel/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "test:design-system": "playwright test --config playwright.design-system.config.ts",
    "spec:check": "tsx scripts/validate-specs.ts && tsx scripts/validate-runtime.ts && tsx scripts/validate-tailwind.ts && tsx scripts/validate-design-source.ts && tsx scripts/validate-design-system.ts",
    "db:generate": "pnpm --filter @hansel/api prisma generate",
    "db:migrate:dev": "pnpm --filter @hansel/api prisma migrate dev",
    "verify": "pnpm spec:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm --filter @hansel/web build:storybook && pnpm test:design-system"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  }
}
