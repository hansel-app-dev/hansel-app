{
  "name": "@hansel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && tsx ../../scripts/validate-tailwind-build.ts",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --quiet",
    "dev": "vite",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --no-open -p 6006",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hansel/contracts": "workspace:*",
    "@hookform/resolvers": "^6.0.0",
    "@material-symbols/font-100": "0.48.1",
    "@material-symbols/font-200": "0.48.1",
    "@vitejs/plugin-react": "^6.1.2",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "vite": "^8.3.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  }
}
