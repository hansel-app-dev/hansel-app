generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingEntryPath {
  NEW_ORGANIZATION
  ORGANIZATION_INVITATION
  SITE_INVITATION
}

enum OnboardingStep {
  VERIFY_EMAIL
  PERSONAL_PROFILE
  PLAN_SELECTION
  PAYMENT
  ORGANIZATION_PROFILE
  DISCOVERY
  COMPLETE
}

enum VerificationPurpose {
  ONBOARDING_EMAIL
  PASSWORD_RECOVERY
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum ApplicationCredentialKind {
  ACCESS
  REFRESH
}

enum EmailMessageKind {
  ONBOARDING_WELCOME
}

enum EmailDeliveryStatus {
  PENDING
  DELIVERED
  TERMINAL
}

enum ExternalAuthProvider {
  GOOGLE
  MICROSOFT
  APPLE
}

enum ExternalAuthIntent {
  LOGIN
  ONBOARDING
}

enum SiteOrganizationAccess {
  VIEW_COMMENT
  EDIT_MANAGE
}

enum SiteAccessScope {
  ORGANIZATION
  PEOPLE_INVITED
  PRIVATE
}

enum SiteRole {
  ADMINISTRATOR
  EDITOR
  VIEWER
}

enum SiteInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum AllocationPlanUploadStatus {
  PENDING
  COMPLETED
  REJECTED
  EXPIRED
}

enum SignTypeColor {
  SLATE
  RED
  TEAL
}

enum SignStatus {
  UNSPECIFIED
  IN_PROGRESS
  APPROVED
}

model User {
  id                            String                               @id @default(uuid()) @db.Uuid
  email                         String                               @unique
  emailVerifiedAt               DateTime?
  password                      PasswordCredential?
  consents                      ConsentRecord[]
  challenges                    VerificationChallenge[]
  journeys                      OnboardingJourney[]
  memberships                   Membership[]
  personalProfile               PersonalProfile?
  planSelection                 OnboardingPlanSelection?
  continuation                  OnboardingContinuation?
  sessionFamilies               ApplicationSessionFamily[]
  passwordAuthenticationState   PasswordAuthenticationState?
  passwordLockNotifications     PasswordLockNotificationIntent[]
  passwordRecoveryNotifications PasswordRecoveryNotificationIntent[]
  externalIdentities            ExternalIdentity[]
  allocationPlans               AllocationPlan[]
  allocationPlanUploads         AllocationPlanUpload[]
  createdAt                     DateTime                             @default(now())
  updatedAt                     DateTime                             @updatedAt
}

model ExternalIdentity {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  provider  ExternalAuthProvider
  subject   String               @db.VarChar(512)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([provider, subject])
  @@unique([provider, userId])
  @@index([userId])
}

model ExternalAuthorizationTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  provider           ExternalAuthProvider
  intent             ExternalAuthIntent
  stateDigest        String               @unique @db.VarChar(64)
  nonceDigest        String               @db.VarChar(64)
  pkceVerifierDigest String?              @db.VarChar(64)
  sealedSecrets      String
  redirectUri        String               @db.VarChar(2048)
  termsVersion       String?              @db.VarChar(64)
  privacyVersion     String?              @db.VarChar(64)
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime             @default(now())

  @@index([provider, expiresAt, consumedAt])
  @@index([expiresAt])
}

model OnboardingPlanSelection {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  planId          String
  priceId         String
  billingInterval BillingInterval?
  amountMinor     Int?
  currency        String
  paymentRequired Boolean
  maximumSites    Int?
  catalogVersion  String
  selectedAt      DateTime
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PersonalProfile {
  userId          String   @id @db.Uuid
  firstName       String
  lastName        String
  jobTitle        String
  jobTitleOther   String?
  department      String
  departmentOther String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OnboardingContinuation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  credentialDigest String   @unique
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordCredential {
  userId        String   @id @db.Uuid
  passwordHash  String
  pepperVersion Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PasswordAuthenticationState {
  userId          String    @id @db.Uuid
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime?
  lockedUntil     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lockedUntil])
}

model PasswordLockNotificationIntent {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  lockStartedAt  DateTime
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime
  leaseOwner     String?             @db.VarChar(128)
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  terminalAt     DateTime?
  providerId     String?             @db.VarChar(256)
  lastErrorCode  String?             @db.VarChar(64)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, lockStartedAt])
  @@index([status, nextAttemptAt])
}

model PasswordRecoveryInitiation {
  id               String   @id @default(uuid()) @db.Uuid
  identifierDigest String   @db.VarChar(64)
  requestedAt      DateTime @default(now())
  expiresAt        DateTime

  @@index([identifierDigest, requestedAt])
  @@index([expiresAt])
  @@index([requestedAt])
}

model PasswordRecoveryNotificationIntent {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  resetChallengeId String              @unique @db.Uuid
  status           EmailDeliveryStatus @default(PENDING)
  attempts         Int                 @default(0)
  nextAttemptAt    DateTime
  leaseOwner       String?             @db.VarChar(128)
  leaseExpiresAt   DateTime?
  deliveredAt      DateTime?
  terminalAt       DateTime?
  providerId       String?             @db.VarChar(256)
  lastErrorCode    String?             @db.VarChar(64)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, nextAttemptAt])
}

model ConsentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  termsVersion   String
  privacyVersion String
  onboardingPath String
  country        String
  consentedAt    DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model VerificationChallenge {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  purpose        VerificationPurpose
  codeDigest     String
  expiresAt      DateTime
  failedAttempts Int                 @default(0)
  sentAt         DateTime
  consumedAt     DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([userId, purpose, sentAt])
}

model OnboardingJourney {
  id                            String                         @id @default(uuid()) @db.Uuid
  userId                        String                         @db.Uuid
  entryPath                     OnboardingEntryPath
  currentStep                   OnboardingStep
  completedAt                   DateTime?
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId                      String?                        @unique @db.Uuid
  tenant                        Tenant?                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organizationProfileSubmission OrganizationProfileSubmission?
  discoveryResponse             OnboardingDiscoveryResponse?
  discoverySubmission           OnboardingDiscoverySubmission?
  emailDeliveryIntents          EmailDeliveryIntent[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([userId, completedAt])
}

model Tenant {
  id                          String                      @id @default(uuid()) @db.Uuid
  name                        String
  country                     String
  industry                    String
  placeService                String
  organizationSize            String
  memberships                 Membership[]
  onboardingJourney           OnboardingJourney?
  sessionFamilies             ApplicationSessionFamily[]
  sites                       Site[]
  siteCreationRequests        SiteCreationRequest[]
  allocationPlans             AllocationPlan[]
  signTypes                   SignType[]
  signs                       Sign[]
  allocationPlanUploads       AllocationPlanUpload[]
  allocationPlanUploadBatches AllocationPlanUploadBatch[]
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
}

model OrganizationProfileSubmission {
  id                   String            @id @default(uuid()) @db.Uuid
  journeyId            String            @unique @db.Uuid
  submissionKeyDigest  String            @unique
  credentialDigest     String
  requestDigest        String?
  nextCredentialDigest String?
  outcome              String?
  expiresAt            DateTime
  consumedAt           DateTime?
  journey              OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model OnboardingDiscoveryResponse {
  id                     String            @id @default(uuid()) @db.Uuid
  journeyId              String            @unique @db.Uuid
  outcome                String
  currentManagement      String?
  currentManagementOther String?
  challenges             String?
  journey                OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model OnboardingDiscoverySubmission {
  id                  String            @id @default(uuid()) @db.Uuid
  journeyId           String            @unique @db.Uuid
  submissionKeyDigest String            @unique
  credentialDigest    String
  requestDigest       String?
  outcome             String?
  expiresAt           DateTime
  consumedAt          DateTime?
  journey             OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model EmailDeliveryIntent {
  id                    String              @id @default(uuid()) @db.Uuid
  journeyId             String              @db.Uuid
  kind                  EmailMessageKind
  status                EmailDeliveryStatus @default(PENDING)
  attemptCount          Int                 @default(0)
  nextAttemptAt         DateTime
  leaseOwner            String?             @db.VarChar(128)
  leaseExpiresAt        DateTime?
  providerMessageId     String?             @db.VarChar(256)
  terminalFailureReason String?             @db.VarChar(64)
  deliveredAt           DateTime?
  journey               OnboardingJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([journeyId, kind])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model Membership {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  tenantId     String      @db.Uuid
  roleId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdSites Site[]      @relation("SiteCreator")
  siteGrants   SiteGrant[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Site {
  id                          String                      @id @default(uuid()) @db.Uuid
  tenantId                    String                      @db.Uuid
  createdByMembershipId       String                      @db.Uuid
  name                        String
  accessScope                 SiteAccessScope
  organizationAccess          SiteOrganizationAccess?
  tenant                      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy                   Membership                  @relation("SiteCreator", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  grants                      SiteGrant[]
  invitations                 SiteInvitation[]
  creationRequests            SiteCreationRequest[]
  allocationPlans             AllocationPlan[]
  signTypes                   SignType[]
  signs                       Sign[]
  allocationPlanUploads       AllocationPlanUpload[]
  allocationPlanUploadBatches AllocationPlanUploadBatch[]
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model SignType {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  siteId         String        @db.Uuid
  name           String        @db.VarChar(80)
  normalizedName String        @db.VarChar(80)
  color          SignTypeColor
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site          @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  signs          Sign[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([id, tenantId, siteId])
  @@unique([tenantId, siteId, normalizedName])
  @@index([siteId, createdAt])
}

model Sign {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @db.Uuid
  siteId         String     @db.Uuid
  signTypeId     String     @db.Uuid
  code           String     @db.VarChar(40)
  normalizedCode String     @db.VarChar(40)
  quantity       Int        @default(1)
  location       String     @default("") @db.VarChar(200)
  content        String     @default("") @db.VarChar(200)
  comments       String     @default("") @db.VarChar(1000)
  status         SignStatus @default(UNSPECIFIED)
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site       @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  signType       SignType   @relation(fields: [signTypeId, tenantId, siteId], references: [id, tenantId, siteId], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([tenantId, siteId, normalizedCode])
  @@index([signTypeId, normalizedCode])
}

model AllocationPlan {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  siteId         String                @db.Uuid
  uploadedById   String                @db.Uuid
  objectKey      String                @unique @db.VarChar(512)
  filename       String                @db.VarChar(255)
  mediaType      String                @db.VarChar(32)
  byteSize       Int
  checksumSha256 String                @db.VarChar(44)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site                  @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploadedBy     User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  upload         AllocationPlanUpload?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([id, tenantId])
  @@index([siteId, createdAt, id])
}

model AllocationPlanUploadBatch {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  siteId        String                 @db.Uuid
  keyDigest     String                 @db.VarChar(64)
  requestDigest String                 @db.VarChar(64)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site          Site                   @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploads       AllocationPlanUpload[]
  createdAt     DateTime               @default(now())

  @@unique([tenantId, keyDigest])
  @@unique([id, tenantId])
  @@index([siteId])
}

model AllocationPlanUpload {
  id               String                     @id @default(uuid()) @db.Uuid
  batchId          String                     @db.Uuid
  tenantId         String                     @db.Uuid
  siteId           String                     @db.Uuid
  uploadedById     String                     @db.Uuid
  allocationPlanId String?                    @unique @db.Uuid
  objectKey        String                     @unique @db.VarChar(512)
  filename         String                     @db.VarChar(255)
  mediaType        String                     @db.VarChar(32)
  byteSize         Int
  checksumSha256   String                     @db.VarChar(44)
  status           AllocationPlanUploadStatus @default(PENDING)
  rejectionCode    String?                    @db.VarChar(64)
  expiresAt        DateTime
  batch            AllocationPlanUploadBatch  @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site             Site                       @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploadedBy       User                       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  allocationPlan   AllocationPlan?            @relation(fields: [allocationPlanId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([id, tenantId])
  @@unique([allocationPlanId, tenantId])
  @@index([siteId, status])
  @@index([status, expiresAt])
}

model SiteGrant {
  id           String     @id @default(uuid()) @db.Uuid
  siteId       String     @db.Uuid
  membershipId String     @db.Uuid
  tenantId     String     @db.Uuid
  role         SiteRole
  site         Site       @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([siteId, membershipId])
  @@index([membershipId])
}

model SiteInvitation {
  id          String                        @id @default(uuid()) @db.Uuid
  siteId      String                        @db.Uuid
  tenantId    String                        @db.Uuid
  email       String
  role        SiteRole
  tokenDigest String                        @unique @db.VarChar(64)
  status      SiteInvitationStatus          @default(PENDING)
  expiresAt   DateTime
  site        Site                          @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  delivery    SiteInvitationDeliveryIntent?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([siteId, email])
  @@unique([id, tenantId])
  @@index([email, status])
  @@index([expiresAt])
}

model SiteInvitationDeliveryIntent {
  id             String              @id @default(uuid()) @db.Uuid
  invitationId   String              @unique @db.Uuid
  tenantId       String              @db.Uuid
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime
  leaseOwner     String?             @db.VarChar(128)
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  terminalAt     DateTime?
  providerId     String?             @db.VarChar(256)
  lastErrorCode  String?             @db.VarChar(64)
  invitation     SiteInvitation      @relation(fields: [invitationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([invitationId, tenantId])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model SiteCreationRequest {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  keyDigest     String   @db.VarChar(64)
  requestDigest String   @db.VarChar(64)
  siteId        String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site          Site     @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([tenantId, keyDigest])
  @@index([siteId])
}

model ApplicationSessionFamily {
  id                String                         @id @default(uuid()) @db.Uuid
  userId            String                         @db.Uuid
  tenantId          String                         @db.Uuid
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials       ApplicationSessionCredential[]
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
}

model ApplicationSessionCredential {
  id               String                    @id @default(uuid()) @db.Uuid
  familyId         String                    @db.Uuid
  kind             ApplicationCredentialKind
  credentialDigest String                    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  family           ApplicationSessionFamily  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())

  @@index([familyId, kind, expiresAt])
}
