generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingEntryPath {
  NEW_ORGANIZATION
  ORGANIZATION_INVITATION
  SITE_INVITATION
}

enum OnboardingStep {
  VERIFY_EMAIL
  PERSONAL_PROFILE
  PLAN_SELECTION
  PAYMENT
  ORGANIZATION_PROFILE
  DISCOVERY
  COMPLETE
}

enum VerificationPurpose {
  ONBOARDING_EMAIL
  PASSWORD_RECOVERY
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum ApplicationCredentialKind {
  ACCESS
  REFRESH
}

enum EmailMessageKind {
  ONBOARDING_WELCOME
}

enum EmailDeliveryStatus {
  PENDING
  DELIVERED
  TERMINAL
}

model User {
  id              String                     @id @default(uuid()) @db.Uuid
  email           String                     @unique
  emailVerifiedAt DateTime?
  password        PasswordCredential?
  consents        ConsentRecord[]
  challenges      VerificationChallenge[]
  journeys        OnboardingJourney[]
  memberships     Membership[]
  personalProfile PersonalProfile?
  planSelection   OnboardingPlanSelection?
  continuation    OnboardingContinuation?
  sessionFamilies ApplicationSessionFamily[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
}

model OnboardingPlanSelection {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  planId          String
  priceId         String
  billingInterval BillingInterval?
  amountMinor     Int?
  currency        String
  paymentRequired Boolean
  maximumSites    Int?
  catalogVersion  String
  selectedAt      DateTime
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PersonalProfile {
  userId          String   @id @db.Uuid
  firstName       String
  lastName        String
  jobTitle        String
  jobTitleOther   String?
  department      String
  departmentOther String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OnboardingContinuation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  credentialDigest String   @unique
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordCredential {
  userId        String   @id @db.Uuid
  passwordHash  String
  pepperVersion Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ConsentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  termsVersion   String
  privacyVersion String
  onboardingPath String
  country        String
  consentedAt    DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model VerificationChallenge {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  purpose        VerificationPurpose
  codeDigest     String
  expiresAt      DateTime
  failedAttempts Int                 @default(0)
  sentAt         DateTime
  consumedAt     DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([userId, purpose, sentAt])
}

model OnboardingJourney {
  id                            String                         @id @default(uuid()) @db.Uuid
  userId                        String                         @db.Uuid
  entryPath                     OnboardingEntryPath
  currentStep                   OnboardingStep
  completedAt                   DateTime?
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId                      String?                        @unique @db.Uuid
  tenant                        Tenant?                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organizationProfileSubmission OrganizationProfileSubmission?
  discoveryResponse             OnboardingDiscoveryResponse?
  discoverySubmission           OnboardingDiscoverySubmission?
  emailDeliveryIntents          EmailDeliveryIntent[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([userId, completedAt])
}

model Tenant {
  id                String                     @id @default(uuid()) @db.Uuid
  name              String
  country           String
  industry          String
  placeService      String
  organizationSize  String
  memberships       Membership[]
  onboardingJourney OnboardingJourney?
  sessionFamilies   ApplicationSessionFamily[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
}

model OrganizationProfileSubmission {
  id                   String            @id @default(uuid()) @db.Uuid
  journeyId            String            @unique @db.Uuid
  submissionKeyDigest  String            @unique
  credentialDigest     String
  requestDigest        String?
  nextCredentialDigest String?
  outcome              String?
  expiresAt            DateTime
  consumedAt           DateTime?
  journey              OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model OnboardingDiscoveryResponse {
  id                     String            @id @default(uuid()) @db.Uuid
  journeyId              String            @unique @db.Uuid
  outcome                String
  currentManagement      String?
  currentManagementOther String?
  challenges             String?
  journey                OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model OnboardingDiscoverySubmission {
  id                  String            @id @default(uuid()) @db.Uuid
  journeyId           String            @unique @db.Uuid
  submissionKeyDigest String            @unique
  credentialDigest    String
  requestDigest       String?
  outcome             String?
  expiresAt           DateTime
  consumedAt          DateTime?
  journey             OnboardingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model EmailDeliveryIntent {
  id                    String              @id @default(uuid()) @db.Uuid
  journeyId             String              @db.Uuid
  kind                  EmailMessageKind
  status                EmailDeliveryStatus @default(PENDING)
  attemptCount          Int                 @default(0)
  nextAttemptAt         DateTime
  leaseOwner            String?             @db.VarChar(128)
  leaseExpiresAt        DateTime?
  providerMessageId     String?             @db.VarChar(256)
  terminalFailureReason String?             @db.VarChar(64)
  deliveredAt           DateTime?
  journey               OnboardingJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([journeyId, kind])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model ApplicationSessionFamily {
  id                String                         @id @default(uuid()) @db.Uuid
  userId            String                         @db.Uuid
  tenantId          String                         @db.Uuid
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials       ApplicationSessionCredential[]
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
}

model ApplicationSessionCredential {
  id               String                    @id @default(uuid()) @db.Uuid
  familyId         String                    @db.Uuid
  kind             ApplicationCredentialKind
  credentialDigest String                    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  family           ApplicationSessionFamily  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())

  @@index([familyId, kind, expiresAt])
}
