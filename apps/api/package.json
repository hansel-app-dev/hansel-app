{
  "name": "@hansel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @hansel/contracts build && tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma": "prisma"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.26.0",
    "@hansel/contracts": "workspace:*",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.10",
    "openid-client": "^6.8.7",
    "prisma": "^6.15.0",
    "resend": "^6.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
